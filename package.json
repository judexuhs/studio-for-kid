{
  "name": "pebli-canvas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {"node": ">=22"},
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "test": "node --test src/*.test.js server/*.test.js cloudflare/*.test.js",
    "preview": "node scripts/dev.mjs --preview",
    "package": "npm run build",
    "cf:deploy": "npm run build && wrangler deploy",
    "cf:preview": "wrangler dev --ip 127.0.0.1 --port 4176 --persist-to .wrangler/preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "0.468.0"
  },
  "devDependencies": {
    "vite": "^6.4.5",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright-core": "~1.48.2",
    "wrangler": "4.124.0"
  }
}
