{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pebli-studio",
  "account_id": "a90d577d4d909f9dad58ace217bf44dc",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-05",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {"bindings": [{"name": "JOBS", "class_name": "PebliJobs"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["PebliJobs"]}],
  "r2_buckets": [{"binding": "MEDIA", "bucket_name": "pebli-private-media"}],
  "vars": {"OPENROUTER_IMAGE_MODEL": "qwen/qwen-image-3"},
  "observability": {"enabled": false}
}
